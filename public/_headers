# Security headers for the Cloudflare Workers assets layer.
#
# next.config.ts sets the same headers, but Next only applies those to
# responses it serves itself. The prerendered pages of this app are handed
# straight to the browser by the Workers assets binding, which never runs the
# Next server — so without this file production shipped no security headers at
# all while a local `next start` looked perfectly fine.
#
# Keep this list in step with securityHeaders in next.config.ts.
#
# The CSP is Report-Only on purpose: it has to allow Google Identity Services
# (sign-in) and Razorpay Checkout (revenue), and enforcing a policy that has
# never seen a real payment risks breaking one of them silently. Watch the
# browser console on /login and /pricing, then rename the header to
# Content-Security-Policy once it stays quiet.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://accounts.google.com https://*.googleusercontent.com https://checkout.razorpay.com https://api.razorpay.com https://*.razorpay.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://api.loopupward.com https://accounts.google.com https://*.googleusercontent.com https://checkout.razorpay.com https://api.razorpay.com https://*.razorpay.com; frame-src 'self' https://accounts.google.com https://*.googleusercontent.com https://checkout.razorpay.com https://api.razorpay.com https://*.razorpay.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
